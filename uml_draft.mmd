classDiagram
    class Pet {
        name
        type
        get_info()
    }
    class Task {
        type
        time
        priority
        remind()
    }
    class Owner {
        name
        available_time
        get_plan()
    }
    class Scheduler {
        date
        time_block
        generate_plan()
    }
    Owner "1" --> "*" Pet : has
    Owner "1" --> "*" Task : has
    Scheduler ..> Task : schedules